# Copy to .env and fill locally. Do not commit the filled file.
# Binaries receive addresses and storage paths through their CLI arguments.
INDEXER_BIND_ADDRESS=
WEB_BIND_ADDRESS=
INDEXER_DATA_DIR=var/xmoney/transactions
LAUNCHPAD_DATA_DIR=var/launchpad

# Required by the web application. Use your own public Pinata gateway prefix.
PINATA_JWT=
IPFS_GATEWAY=https://YOUR_GATEWAY.mypinata.cloud/ipfs/

# Optional: uncomment only when configured; empty values are invalid.
# X_MONEY_HANDLE=@your_account
# X_MONEY_URL=https://your-configured-payment-destination.example/
# Public HTTPS links shown as header icons; each icon is hidden when unset.
# GITHUB_URL=https://github.com/your-org/your-repo

# Read-only market data and review RPC, always processed commitment.
# Keep authenticated RPC URLs private.
RPC_URL=https://api.mainnet-beta.solana.com
# Optional; Jupiter keyless access works at the default conservative pace.
# JUPITER_API_KEY=YOUR_PRIVATE_KEY
# LOOKUP_TABLE=YOUR_VERIFIED_LOOKUP_TABLE
# VERIFY_AIRDROP_WALLET=YOUR_RECIPIENT_PUBLIC_KEY

# Optional private CDP endpoint for the recorder; never expose session credentials.
# KAMELEO_CDP_URL=YOUR_PROFILE_CDP_WEBSOCKET_URL
# CAPTURE_OUTPUT_DIR=var/captures/NEW_SESSION

# Browser test override; otherwise Playwright uses its installed Chromium.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/path/to/chromium
